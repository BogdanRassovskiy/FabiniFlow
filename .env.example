OPENROUTER_API_KEY=sk-or-...
# Volitelné: výchozí model, pokud se nevybere v UI
OPENROUTER_DEFAULT_MODEL=
DJANGO_DEBUG=1
# Volitelné: port aplikace (výchozí 4445)
FABINI_PORT=
# Server (demo): naslouchat na všech rozhraních, vypnout DEBUG, doména a vlastní tajný klíč
FABINI_HOST=
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
# Za HTTPS proxy (nginx, Caddy): např. https://fabini.example.com
CSRF_TRUSTED_ORIGINS=
